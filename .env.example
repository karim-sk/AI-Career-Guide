# ============================================================
# AI Career Navigator — Environment Configuration
# ============================================================

PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ai_career_navigator

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_minimum_32_characters
JWT_EXPIRES_IN=7d

# ============================================================
# AI PROVIDER — Uncomment ONE block only
# ============================================================

# ── ⭐ OPTION 1: Google Gemini FREE (RECOMMENDED) ───────────
# 1500 requests/day FREE — no credit card
# Get key: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=AIzaSy-YOUR-FREE-KEY-HERE
GEMINI_MODEL=gemini-1.5-flash

# ── ⭐ OPTION 2: Groq FREE (fastest) ────────────────────────
# 14400 requests/day FREE — no credit card
# Get key: https://console.groq.com
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_YOUR-FREE-KEY-HERE
# GROQ_MODEL=llama-3.1-8b-instant

# ── OPTION 3: OpenRouter (free models) ──────────────────────
# Get key: https://openrouter.ai
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-YOUR-KEY-HERE
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ── OPTION 4: Anthropic Claude (paid) ───────────────────────
# Get key: https://console.anthropic.com
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-api03-YOUR-KEY-HERE
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── OPTION 5: OpenAI GPT (paid) ─────────────────────────────
# Get key: https://platform.openai.com/api-keys
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-YOUR-KEY-HERE
# OPENAI_MODEL=gpt-3.5-turbo

# ============================================================
# App works WITHOUT any AI key — assessment, scoring, skill
# gap analysis all work. AI only used for roadmap + mentor.
# ============================================================

# ============================================================
# CAREER PLATFORM ADDITIONS (resume • jobs • verification)
# All optional — sensible defaults apply.
# ============================================================

# ── Job providers (documented public APIs only — no scraping) ───────────────
# Comma list. Default: adzuna (if keys set) + remotive + arbeitnow.
#   adzuna     needs keys → https://developer.adzuna.com/  (free tier)
#   remotive   no key, REMOTE jobs only; keep request volume low and link back (ToS)
#   arbeitnow  no key, Europe + remote
#   sample     LOCAL DEV/TESTS ONLY — fake records labelled "not a real vacancy", no apply link
# JOB_PROVIDERS=adzuna,remotive,arbeitnow
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=in            # gb, us, in, au, ca, de, fr, ...
# JOB_CACHE_TTL_MINUTES=60     # in-memory provider cache (Remotive is held ≥ 6h)
# JOB_STALE_DAYS=21            # listings not seen for this long are labelled "may be outdated"
# JOB_PROVIDER_TIMEOUT_MS=8000

# ── Resume handling ──────────────────────────────────────────────────────────
# RESUME_STORAGE=gridfs        # gridfs (default; persistent, stored in MongoDB) | none (keep only extracted data)
# RESUME_MAX_MB=5

# ── Matching & verification ──────────────────────────────────────────────────
# MATCH_WEIGHTS={"skills":50,"experience":20,"projects":15,"education":10,"alignment":5}
# VERIFICATION_COOLDOWN_MINUTES=30   # wait after a failed skill check (0 disables)
# VERIFICATION_DAILY_CAP=6           # max skill-check attempts per skill per 24h
